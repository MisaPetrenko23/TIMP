@echo off
echo Removing Windows "downloaded from internet" block...
powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-ChildItem -LiteralPath '%~dp0' -Recurse -File | ForEach-Object { Unblock-File -LiteralPath $_.FullName -ErrorAction SilentlyContinue }"
echo Starting MFCApplication1.exe...
start "" "%~dp0MFCApplication1.exe"
